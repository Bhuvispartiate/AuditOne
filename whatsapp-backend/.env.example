# WhatsApp Instance Settings
WHATSAPP_INSTANCE_NAME=oxev-main
CLIENT_NAME=OXIS WhatsApp Service
OS_NAME=OXIS WhatsApp Engine
CONNECT_ON_STARTUP=true

# WhatsApp Engine & Debugging
WA_DEBUG=INFO
LOG_TYPE=console
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30
LOG_DIRECTORY=./logs
LOG_COMPRESS=true

# Optional Webhook & Event Integration (Leave disabled if not used)
WEBHOOK_FILES=false
AMQP_GLOBAL_ENABLED=false
NATS_GLOBAL_ENABLED=false
MINIO_ENABLED=false