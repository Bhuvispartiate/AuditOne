# Security & API Authentication Keys
# OXIS Global Admin key (full administrative access)
OXIS_GLOBAL_API_KEY=oxis_global_secret_key_change_me_in_production
GLOBAL_API_KEY=oxis_global_secret_key_change_me_in_production

# OXEV Service-to-Service API Key (used by OXEV backend to call automation endpoints)
